{
  "name": "tarkkash",
  "version": "0.1.0",
  "private": true,
  "description": "Tarkkash: a managed local-services marketplace for Hyderabad. Next.js 16, React 19, Supabase (Postgres + RLS), Tailwind CSS v4.",
  "homepage": "https://www.tarkkash.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rrachet/Tarkkash.git"
  },
  "license": "UNLICENSED",
  "keywords": [
    "marketplace",
    "local-services",
    "saas",
    "nextjs",
    "supabase",
    "postgres",
    "row-level-security",
    "tailwindcss",
    "hyderabad",
    "india"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "e2e": "node --env-file=.env.local scripts/e2e.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.61.0",
    "next": "^16.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
