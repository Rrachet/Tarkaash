# Copy to .env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=https://mimlefjoxiagejvyopfd.supabase.co
# Publishable (browser-safe) key. Row level security protects all data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public site URL, used for auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO: keep 0 while the site shows demo vendors and reviews. Set to 1 at public launch.
NEXT_PUBLIC_ALLOW_INDEXING=0
# Optional: Google Search Console HTML-tag verification code.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
